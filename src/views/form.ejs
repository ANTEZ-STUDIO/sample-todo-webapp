<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= action === 'create' ? '新しいToDo' : 'ToDoを編集' %> - ToDo管理アプリ</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1><%= action === 'create' ? '📝 新しいToDoを追加' : '✏️ ToDoを編集' %></h1>
      <a href="/" class="btn btn-secondary">← 戻る</a>
    </header>

    <main>
      <form action="<%= action === 'create' ? '/create' : '/update/' + todo.id %>" method="POST" class="todo-form">
        <div class="form-group">
          <label for="title">タイトル <span class="required">*</span></label>
          <input type="text" id="title" name="title" value="<%= todo ? todo.title : '' %>" required>
        </div>

        <div class="form-group">
          <label for="content">内容</label>
          <textarea id="content" name="content" rows="5"><%= todo ? (todo.content || '') : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="due_date">期限</label>
            <input type="date" id="due_date" name="due_date" value="<%= todo ? (todo.due_date || '') : '' %>">
          </div>

          <div class="form-group">
            <label for="priority">優先度 <span class="required">*</span></label>
            <select id="priority" name="priority" required>
              <option value="高" <%= todo && todo.priority === '高' ? 'selected' : '' %>>高</option>
              <option value="中" <%= !todo || todo.priority === '中' ? 'selected' : '' %>>中</option>
              <option value="低" <%= todo && todo.priority === '低' ? 'selected' : '' %>>低</option>
            </select>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= action === 'create' ? '作成' : '更新' %></button>
          <a href="/" class="btn btn-secondary">キャンセル</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
